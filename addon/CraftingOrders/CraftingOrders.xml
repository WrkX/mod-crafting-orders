	<Button name="CraftingOrderSkillButtonTemplate" inherits="ClassTrainerSkillButtonTemplate" hidden="false" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentCount" inherits="GameFontNormal">
					<Size x="0" y="13"/>
					<Anchors>
						<Anchor point="LEFT">
							<Offset x="0" y="0"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				if ( IsModifiedClick and IsModifiedClick() ) then
					local rec = CraftingOrder_GetRecipeByFilteredIndex(this:GetID());
					if rec then
						if HandleModifiedItemClick then
							HandleModifiedItemClick("item:"..rec.itemId..":0:0:0:0:0:0:0");
						end
					end
				else
					CraftingOrderSkillButton_OnClick(this, arg1);
				end
			</OnClick>
			<OnLoad>
					_G[this:GetName().."Count"]:SetPoint("LEFT", this:GetName().."Text", "RIGHT", 2, 0);
			</OnLoad>
			<OnEnter>
					_G[this:GetName().."Count"]:SetTextColor(HIGHLIGHT_FONT_COLOR.r, HIGHLIGHT_FONT_COLOR.g, HIGHLIGHT_FONT_COLOR.b);
			</OnEnter>
			<OnLeave>
					if ( not this.isHighlighted ) then
						_G[this:GetName().."Count"]:SetTextColor(this.r, this.g, this.b);
				end
			</OnLeave>
		</Scripts>
	</Button>
