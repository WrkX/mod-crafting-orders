				</FontString>
				<FontString name="$parentCount" inherits="GameFontHighlightSmall" justifyH="RIGHT">
					<Size>
						<AbsDimension x="0" y="0"/>
					</Size>
					<Anchors>
						<Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="0" y="2"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter>
				if this.itemLink then
					GameTooltip:SetOwner(this, "ANCHOR_TOPLEFT");
					GameTooltip:SetHyperlink(this.itemLink);
					CursorUpdate(this);
				end
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
				ResetCursor();
			</OnLeave>
			<OnUpdate>
					CursorOnUpdate(this, arg1);
			</OnUpdate>
			<OnClick>
				if this.itemLink then
						if HandleModifiedItemClick then
							HandleModifiedItemClick(this.itemLink);
						end
				end
			</OnClick>
		</Scripts>
	</Button>
